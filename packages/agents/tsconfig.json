{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "@placegraph/types": ["packages/types/src"],
      "@placegraph/core": ["packages/core/src"],
      "@placegraph/qloo": ["packages/qloo/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
