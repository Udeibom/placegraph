# =============================================================
# PlaceGraph — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ── Qloo Cultural Intelligence ────────────────────────────────
QLOO_API_KEY=your_qloo_api_key
QLOO_API_BASE_URL=https://hackathon.api.qloo.com   # or https://api.qloo.com

# ── Groq LLM ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile   # or llama-3.1-70b-versatile, mixtral-8x7b-32768

# Optional: separate vision model for floor plan reading
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── HuggingFace Image Generation ─────────────────────────────
HF_TOKEN=your_hf_token
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ── Supabase (optional — for persistent cross-deployment storage)
# Accepts service role key OR publishable/anon key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key  # preferred if available

# ── Local file storage (optional override) ───────────────────
# PLACEGRAPH_DATA_DIR=/absolute/path/to/data
